{
  "name": "temperature-mcp",
  "version": "1.0.0",
  "private": true,
  "description": "Servidor MCP de condicoes meteorologicas atuais via Open-Meteo.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "dev": "tsx watch src/index.ts",
    "typecheck": "tsc -p tsconfig.test.json",
    "test": "tsx --test test/*.test.ts",
    "test:live": "tsx scripts/check-live.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "^2.4.0",
    "@openmeteo/sdk": "^1.29.0",
    "openmeteo": "^1.2.3",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "^2.4.0",
    "@types/node": "^22.0.0",
    "tsx": "^4.0.0",
    "typescript": "^5.9.0"
  }
}
